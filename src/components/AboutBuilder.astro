---
// src/components/AboutBuilder.astro
import NoiseGradient from './NoiseGradient.astro';
---

<section id="about" class="reveal w-full relative scroll-mt-32" style="background-color: #0F1117; border-top: 1px solid #1A1A1A;">
    <div class="max-w-[1100px] mx-auto px-6 py-[120px]">
    <div class="bg-[#111111] border border-[#222222] rounded-2xl p-10 md:p-16 relative overflow-hidden" style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);">

        <!-- Noise gradient aurora -->
        <NoiseGradient
            colors={["#8B5CF6", "#6366F1"]}
            width="100%"
            height="100%"
            opacity={10}
        />

        <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full pointer-events-none" style="background: rgba(37,99,235,0.12); filter: blur(100px); z-index: 1;"></div>
        <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full pointer-events-none" style="background: rgba(37,99,235,0.06); filter: blur(100px); z-index: 1;"></div>

        <div class="relative z-10 max-w-2xl">

            <p class="font-mono text-[11px] tracking-[0.15em] text-[#444444] uppercase mb-8">The Builder</p>

            <div class="mb-8">
                <h3 class="text-[clamp(28px,3.5vw,40px)] font-[800] text-[#FAFAFA] mb-2 tracking-tight">Khairul Azri</h3>
                <p class="text-base text-[#2563EB] font-semibold tracking-wide">Founder & Performance Marketer</p>
            </div>

            <div class="space-y-5 text-[17px] text-[#888888] leading-[1.7]">
                <p>
                    With nearly a decade of experience building marketing funnels and automation systems, I've seen exactly where businesses bleed money. The biggest culprit? A beautiful but bloated website that takes too long to load.
                </p>
                <p>
                    Most web design agencies focus entirely on aesthetics. I built Stegg.dev because I know that <strong class="text-[#FAFAFA] font-semibold">performance is marketing.</strong> Every line of code we write is engineered to lower your ad costs, stop mobile bounce rates, and make your funnel actually convert.
                </p>
            </div>

            <div class="mt-10 flex flex-wrap items-center gap-8 pt-8 border-t border-[#222222]">
                <a href="https://wa.me/60196700413?text=Hi%20Khairul,%20I'd%20love%20to%20chat%20about%20fixing%20my%20website's%20performance." class="text-[#FAFAFA] font-bold hover:text-[#2563EB] transition-colors flex items-center gap-2 underline decoration-[#333333] underline-offset-4 hover:decoration-[#2563EB]">
                    Chat on WhatsApp
                    <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                </a>

                <a href="https://www.linkedin.com/in/khairulazri/" target="_blank" rel="noopener noreferrer" class="text-[#888888] hover:text-[#FAFAFA] transition-colors flex items-center gap-2 font-semibold text-sm">
                    <i data-lucide="linkedin" class="w-4 h-4"></i>
                    Connect on LinkedIn
                </a>
            </div>

        </div>
    </div>
    </div>
</section>
