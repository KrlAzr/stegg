---
// src/components/ClientLogos.astro
---

<section class="w-full py-24 bg-white border-y border-slate-200/50 relative z-10">
    <div class="max-w-6xl mx-auto px-6">
        
        <div class="text-center mb-16">
            <p class="text-sm font-bold text-[#2563EB] uppercase tracking-widest mb-3">
                Selected Works
            </p>
            <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
                Trusted by growing local businesses.
            </h2>
        </div>
        
        <div class="grid md:grid-cols-2 gap-8 md:gap-10">
            
            <a href="https://nzcoffee.work/" target="_blank" rel="noopener noreferrer" class="group block rounded-[2.5rem] bg-[#FBFBFD] border border-slate-200 hover:bg-white hover:shadow-[0_25px_50px_-15px_rgba(0,0,0,0.08)] hover:border-slate-300 transition-all duration-500 relative overflow-hidden flex flex-col">
                
                <div class="w-full h-56 md:h-64 bg-slate-100 relative overflow-hidden border-b border-slate-200 shrink-0">
                    <div class="absolute top-0 left-0 w-full h-8 bg-white/80 backdrop-blur-md border-b border-slate-200/60 flex items-center px-4 gap-1.5 z-20">
                        <div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div>
                    </div>
                    <img 
                        src="/nz-coffee-hero.png" 
                        alt="NZ Coffee Website Screenshot" 
                        class="w-full h-full object-cover object-top pt-8 group-hover:scale-105 transition-transform duration-700 ease-out relative z-10" 
                    />
                </div>

                <div class="p-8 md:p-10 relative flex-1 flex flex-col">
                    <div class="absolute -top-10 -right-10 w-40 h-40 bg-[#2563EB]/5 blur-[40px] rounded-full pointer-events-none group-hover:bg-[#2563EB]/15 transition-colors duration-500"></div>

                    <div class="flex items-start justify-between mb-8 relative z-10">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-full bg-white shadow-md shrink-0 overflow-hidden border border-slate-100 flex items-center justify-center">
                                <img src="/nz-coffee-logo.jpg" alt="NZ Coffee Logo" class="w-full h-full object-cover" />
                            </div>
                            <span class="font-extrabold text-2xl text-slate-900 tracking-tighter">NZ Coffee</span>
                        </div>

                        <div class="w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center shadow-sm group-hover:bg-[#2563EB] group-hover:border-[#2563EB] transition-all duration-300 shrink-0">
                            <i data-lucide="arrow-up-right" class="w-5 h-5 text-slate-400 group-hover:text-white transition-colors"></i>
                        </div>
                    </div>

                    <div class="relative z-10 flex-1 flex flex-col">
                        <h3 class="text-xl font-bold text-slate-900 mb-3 tracking-tight">Custom Booking Engine</h3>
                        <p class="text-slate-500 font-medium leading-relaxed mb-8 text-lg flex-1">
                            Engineered a lightning-fast reservation system complete with a secure, real-time admin dashboard for seamless table and customer management.
                        </p>
                        
                        <div class="flex flex-wrap gap-2 mt-auto">
                            <span class="px-3 py-1.5 bg-slate-100 text-slate-600 text-xs font-bold uppercase tracking-wider rounded-lg border border-slate-200/60">Reservation System</span>
                            <span class="px-3 py-1.5 bg-slate-100 text-slate-600 text-xs font-bold uppercase tracking-wider rounded-lg border border-slate-200/60">Admin Dashboard</span>
                            <span class="px-3 py-1.5 bg-[#2563EB]/10 text-[#2563EB] text-xs font-bold uppercase tracking-wider rounded-lg border border-[#2563EB]/20">pSEO</span>
                        </div>
                    </div>
                </div>
            </a>

            <a href="https://alexisemployment.com/" target="_blank" rel="noopener noreferrer" class="group block rounded-[2.5rem] bg-[#FBFBFD] border border-slate-200 hover:bg-white hover:shadow-[0_25px_50px_-15px_rgba(0,0,0,0.08)] hover:border-slate-300 transition-all duration-500 relative overflow-hidden flex flex-col">
                
                <div class="w-full h-56 md:h-64 bg-slate-100 relative overflow-hidden border-b border-slate-200 shrink-0">
                    <div class="absolute top-0 left-0 w-full h-8 bg-white/80 backdrop-blur-md border-b border-slate-200/60 flex items-center px-4 gap-1.5 z-20">
                        <div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div>
                    </div>
                    <img 
                        src="/alexis-hero.png" 
                        alt="Alexis Employment Website Screenshot" 
                        class="w-full h-full object-cover object-top pt-8 group-hover:scale-105 transition-transform duration-700 ease-out relative z-10" 
                    />
                </div>

                <div class="p-8 md:p-10 relative flex-1 flex flex-col">
                    <div class="absolute -top-10 -right-10 w-40 h-40 bg-[#2563EB]/5 blur-[40px] rounded-full pointer-events-none group-hover:bg-[#2563EB]/15 transition-colors duration-500"></div>

                    <div class="flex items-start justify-between mb-8 relative z-10">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-xl bg-white shadow-md shrink-0 border border-slate-100 flex items-center justify-center p-1.5 group-hover:-rotate-3 transition-transform duration-300">
                                <img src="/alexis-logo.png" alt="Alexis Employment Logo" class="w-full h-full object-contain" />
                            </div>
                            <div class="flex flex-col justify-center">
                                <span class="font-black text-2xl text-slate-900 leading-none tracking-tight">ALEXIS</span>
                                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mt-0.5">Employment</span>
                            </div>
                        </div>

                        <div class="w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center shadow-sm group-hover:bg-[#2563EB] group-hover:border-[#2563EB] transition-all duration-300 shrink-0">
                            <i data-lucide="arrow-up-right" class="w-5 h-5 text-slate-400 group-hover:text-white transition-colors"></i>
                        </div>
                    </div>

                    <div class="relative z-10 flex-1 flex flex-col">
                        <h3 class="text-xl font-bold text-slate-900 mb-3 tracking-tight">Agency Portal & Directory</h3>
                        <p class="text-slate-500 font-medium leading-relaxed mb-8 text-lg flex-1">
                            Built a high-performance agency website featuring a dynamic employment directory and secure login/logout functionality for user management.
                        </p>
                        
                        <div class="flex flex-wrap gap-2 mt-auto">
                            <span class="px-3 py-1.5 bg-slate-100 text-slate-600 text-xs font-bold uppercase tracking-wider rounded-lg border border-slate-200/60">Dynamic Directory</span>
                            <span class="px-3 py-1.5 bg-slate-100 text-slate-600 text-xs font-bold uppercase tracking-wider rounded-lg border border-slate-200/60">Auth System</span>
                            <span class="px-3 py-1.5 bg-[#2563EB]/10 text-[#2563EB] text-xs font-bold uppercase tracking-wider rounded-lg border border-[#2563EB]/20">pSEO</span>
                        </div>
                    </div>
                </div>
            </a>

        </div>
    </div>
</section>