---
// src/components/AuditForm.astro
---

<section id="audit-form" class="max-w-4xl mx-auto px-6 mb-32 pt-16 scroll-mt-32">
    <div class="bg-white border border-slate-200 p-10 md:p-14 rounded-[3rem] shadow-[0_25px_60px_-15px_rgba(0,0,0,0.05)] relative overflow-hidden">
        
        <div class="absolute top-0 right-0 w-64 h-64 bg-[#2563EB]/5 blur-[80px] rounded-full pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-slate-50 blur-[80px] rounded-full pointer-events-none"></div>

        <div class="relative z-10 text-center mb-10">
            <h2 class="text-3xl md:text-4xl font-extrabold text-slate-950 mb-4 tracking-tight">Get a Free Website Performance Audit</h2>
            <p class="text-lg text-slate-600">Find out exactly how your current website might hurt your revenue.</p>
        </div>

        <form id="whatsapp-audit-form" class="relative z-10 max-w-xl mx-auto space-y-6">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                    <label for="audit-name" class="block text-sm font-semibold text-slate-900">Your Name</label>
                    <input 
                        type="text" 
                        id="audit-name" 
                        required 
                        placeholder="John Doe"
                        class="w-full px-5 py-3.5 bg-[#FBFBFD] border border-slate-200 rounded-2xl focus:outline-none focus:border-[#2563EB] focus:ring-4 focus:ring-[#2563EB]/10 transition-all text-slate-900 placeholder:text-slate-400 font-medium"
                    >
                </div>

                <div class="space-y-2">
                    <label for="audit-phone" class="block text-sm font-semibold text-slate-900">WhatsApp Number</label>
                    <input 
                        type="tel" 
                        id="audit-phone" 
                        required 
                        placeholder="+60123456789"
                        class="w-full px-5 py-3.5 bg-[#FBFBFD] border border-slate-200 rounded-2xl focus:outline-none focus:border-[#2563EB] focus:ring-4 focus:ring-[#2563EB]/10 transition-all text-slate-900 placeholder:text-slate-400 font-medium"
                    >
                </div>
            </div>

            <div class="space-y-2">
                <label for="audit-url" class="block text-sm font-semibold text-slate-900">Website URL</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                        <i data-lucide="link" class="w-4 h-4 text-slate-400"></i>
                    </div>
                    <input 
                        type="url" 
                        id="audit-url" 
                        required 
                        placeholder="https://yourwebsite.com"
                        class="w-full pl-12 pr-5 py-3.5 bg-[#FBFBFD] border border-slate-200 rounded-2xl focus:outline-none focus:border-[#2563EB] focus:ring-4 focus:ring-[#2563EB]/10 transition-all text-slate-900 placeholder:text-slate-400 font-medium"
                    >
                </div>
            </div>

            <button 
                type="submit" 
                class="w-full mt-4 py-4 px-8 bg-[#2563EB] text-white font-bold text-lg rounded-2xl transition-all shadow-[0_10px_25px_rgba(37,99,235,0.25)] hover:shadow-[0_15px_35px_rgba(37,99,235,0.35)] hover:-translate-y-0.5 flex items-center justify-center gap-2 tracking-tight"
            >
                <i data-lucide="send" class="w-5 h-5"></i>
                Request Free Audit via WhatsApp
            </button>
            <p class="text-center text-xs text-slate-500 font-medium mt-4">No commitment required. Its free!</p>
        </form>

    </div>
</section>

<script is:inline>
    // WhatsApp Interceptor Logic
    const auditForm = document.getElementById('whatsapp-audit-form');
    
    if(auditForm) {
        auditForm.addEventListener('submit', function(e) {
            e.preventDefault(); // Stop normal form submission
            
            // Get values
            const name = document.getElementById('audit-name').value;
            const url = document.getElementById('audit-url').value;
            
            // Format the WhatsApp message
            const message = `Hi Stegg! 👋 My name is ${name}. I'd like to request a free performance audit to see if my site is costing me extra ad money.\n\nMy website is: ${url}`;
            
            // Encode for URL
            const encodedMessage = encodeURIComponent(message);
            
            // Your WhatsApp Number (Ensure it includes country code but no + or spaces)
            const targetPhone = "60196700413";
            
            // Create WhatsApp Link and Redirect
            const whatsappUrl = `https://wa.me/${targetPhone}?text=${encodedMessage}`;
            
            // Track conversion if FB Pixel is present
            if (typeof fbq === 'function') {
                fbq('track', 'Lead');
            }

            window.open(whatsappUrl, '_blank');
        });
    }
</script>