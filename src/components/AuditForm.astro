---
// src/components/AuditForm.astro
---

<section id="audit-form" class="reveal w-full scroll-mt-32" style="background-color: #141820; border-top: 1px solid #1A1A1A;">
    <div class="max-w-[1100px] mx-auto px-6 py-[120px]">
    <div class="bg-[#111111] border border-[#222222] p-10 md:p-14 rounded-2xl relative overflow-hidden" style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);">

        <div class="absolute top-0 right-0 w-80 h-80 rounded-full pointer-events-none" style="background: rgba(37,99,235,0.06); filter: blur(80px);"></div>

        <div class="relative z-10 mb-10">
            <p class="font-mono text-[11px] tracking-[0.15em] text-[#444444] uppercase mb-4">Free Offer</p>
            <h2 class="text-[clamp(28px,3.5vw,42px)] font-[800] text-[#FAFAFA] mb-3 tracking-tight leading-[1.1]">Get a Free Website Performance Audit</h2>
            <p class="text-[17px] text-[#888888] leading-[1.7]">Find out exactly how your current website might hurt your revenue.</p>
        </div>

        <form id="whatsapp-audit-form" class="relative z-10 max-w-xl space-y-5">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="space-y-2">
                    <label for="audit-name" class="block text-sm font-semibold text-[#FAFAFA]">Your Name</label>
                    <input
                        type="text"
                        id="audit-name"
                        required
                        placeholder="John Doe"
                        class="w-full px-5 py-3.5 bg-[#0A0A0A] border border-[#2A2A2A] rounded-xl focus:outline-none focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/20 transition-all text-[#FAFAFA] placeholder:text-[#444444] font-medium text-[15px]"
                    >
                </div>

                <div class="space-y-2">
                    <label for="audit-phone" class="block text-sm font-semibold text-[#FAFAFA]">WhatsApp Number</label>
                    <input
                        type="tel"
                        id="audit-phone"
                        required
                        placeholder="+60123456789"
                        class="w-full px-5 py-3.5 bg-[#0A0A0A] border border-[#2A2A2A] rounded-xl focus:outline-none focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/20 transition-all text-[#FAFAFA] placeholder:text-[#444444] font-medium text-[15px]"
                    >
                </div>
            </div>

            <div class="space-y-2">
                <label for="audit-url" class="block text-sm font-semibold text-[#FAFAFA]">Website URL</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                        <i data-lucide="link" class="w-4 h-4 text-[#444444]"></i>
                    </div>
                    <input
                        type="url"
                        id="audit-url"
                        required
                        placeholder="https://yourwebsite.com"
                        class="w-full pl-12 pr-5 py-3.5 bg-[#0A0A0A] border border-[#2A2A2A] rounded-xl focus:outline-none focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/20 transition-all text-[#FAFAFA] placeholder:text-[#444444] font-medium text-[15px]"
                    >
                </div>
            </div>

            <button
                type="submit"
                class="audit-btn w-full mt-2 py-4 px-8 bg-[#2563EB] text-white font-bold text-base rounded-xl shadow-[0_8px_25px_rgba(37,99,235,0.3)] flex items-center justify-center gap-2 tracking-tight"
            >
                <i data-lucide="send" class="w-4 h-4"></i>
                Request Free Audit via WhatsApp
            </button>
            <p class="text-xs text-[#444444] font-medium mt-3">No commitment required. It's free!</p>
        </form>

    </div>
    </div>
</section>

<style>
    .audit-btn {
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
                    box-shadow 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .audit-btn:hover  {
        transform: scale(1.02) translateY(-1px);
        box-shadow: 0 15px 35px rgba(37,99,235,0.4);
    }
    .audit-btn:active {
        transform: scale(0.97);
        transition-duration: 0.1s;
    }
</style>

<script is:inline>
    const auditForm = document.getElementById('whatsapp-audit-form');

    if(auditForm) {
        auditForm.addEventListener('submit', function(e) {
            e.preventDefault();

            const name = document.getElementById('audit-name').value;
            const url = document.getElementById('audit-url').value;

            const message = `Hi Stegg! 👋 My name is ${name}. I'd like to request a free performance audit to see if my site is costing me extra ad money.\n\nMy website is: ${url}`;
            const encodedMessage = encodeURIComponent(message);
            const targetPhone = "60196700413";
            const whatsappUrl = `https://wa.me/${targetPhone}?text=${encodedMessage}`;

            if (typeof fbq === 'function') {
                fbq('track', 'Lead');
            }

            window.open(whatsappUrl, '_blank');
        });
    }
</script>
