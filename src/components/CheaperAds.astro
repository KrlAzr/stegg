---
// src/components/CheaperAds.astro
---

<section class="reveal w-full py-[120px] border-t border-[#222222]">
    <div class="max-w-[1100px] mx-auto px-6">

        <div class="grid md:grid-cols-2 gap-16 md:gap-24 items-center">

            <div>
                <p class="font-mono text-[11px] tracking-[0.15em] text-[#444444] uppercase mb-6">The Problem</p>
                <h2 class="text-[clamp(32px,4vw,48px)] font-[800] text-[#FAFAFA] mb-6 tracking-tight leading-[1.05]">
                    Why does a slow website cost you money?
                </h2>

                <p class="text-[17px] text-[#888888] mb-5 leading-[1.7]">
                    Think of ad platforms like Facebook and Google as a toll highway. They want traffic to move fast and keep people happy.
                </p>
                <p class="text-[17px] text-[#888888] mb-8 leading-[1.7]">
                    If your website takes too long to load, people click your ad, get annoyed waiting, and immediately leave. <strong class="text-[#FAFAFA] font-semibold">Ad algorithms hate this.</strong>
                </p>

                <div class="pl-6 border-l-2 border-red-500/70">
                    <h4 class="text-[#FAFAFA] font-bold text-xs mb-2 uppercase tracking-wider">The Penalty</h4>
                    <p class="text-[17px] text-[#888888] leading-[1.7]">
                        Ad platforms will secretly force you to pay <span class="text-red-400 font-semibold">double the price</span> just to show your ads to the exact same people.
                    </p>
                </div>
            </div>

            <div class="space-y-5">
                <div class="compare-card bg-[#111111] p-8 rounded-2xl border border-[#222222]" style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);">
                    <div class="flex justify-between items-center mb-7">
                        <span class="text-[#FAFAFA] font-bold uppercase text-xs tracking-widest flex items-center gap-2.5">
                            <span class="w-2 h-2 rounded-full bg-red-500"></span> Unoptimized Site
                        </span>
                        <span class="text-red-400 font-semibold text-xs">Low Search Visibility</span>
                    </div>
                    <div class="flex justify-between items-end border-b border-[#222222] pb-6 mb-5">
                        <div>
                            <div class="text-xs text-[#888888] mb-1.5 font-medium">Cost Per Click</div>
                            <div class="text-3xl text-[#FAFAFA] font-[800] tracking-tight counter" data-target="3.50" data-prefix="RM " data-decimals="2">RM 0.00</div>
                        </div>
                        <div class="text-right">
                            <div class="text-xs text-[#888888] mb-1.5 font-medium">Visitors</div>
                            <div class="text-3xl text-[#FAFAFA] font-[800] tracking-tight counter" data-target="100" data-decimals="0">0</div>
                        </div>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-[#888888] font-medium text-sm">Total Spent:</span>
                        <span class="text-[#FAFAFA] font-[700] text-lg counter" data-target="350.00" data-prefix="RM " data-decimals="2">RM 0.00</span>
                    </div>
                </div>

                <div class="compare-card compare-card-featured bg-[#111111] p-8 rounded-2xl border border-[#333333] relative" style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 0 0 1px rgba(37,99,235,0.15);">
                    <div class="absolute -top-3 right-8 bg-[#2563EB] text-white text-xs font-bold px-4 py-1.5 rounded-full shadow-[0_4px_20px_rgba(37,99,235,0.4)]">
                        YOU SAVE MONEY
                    </div>
                    <div class="flex justify-between items-center mb-7">
                        <span class="text-[#FAFAFA] font-bold uppercase text-xs tracking-widest flex items-center gap-2.5">
                            <span class="w-2 h-2 rounded-full bg-[#2563EB]"></span> High Performance
                        </span>
                        <span class="text-[#2563EB] font-semibold text-xs">Search Priority</span>
                    </div>
                    <div class="flex justify-between items-end border-b border-[#222222] pb-6 mb-5">
                        <div>
                            <div class="text-xs text-[#888888] mb-1.5 font-medium">Cost Per Click</div>
                            <div class="text-3xl text-[#FAFAFA] font-[800] tracking-tight counter" data-target="1.50" data-prefix="RM " data-decimals="2">RM 0.00</div>
                        </div>
                        <div class="text-right">
                            <div class="text-xs text-[#888888] mb-1.5 font-medium">Visitors</div>
                            <div class="text-3xl text-[#FAFAFA] font-[800] tracking-tight counter" data-target="233" data-decimals="0">0</div>
                        </div>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-[#888888] font-medium text-sm">Total Spent:</span>
                        <span class="text-[#FAFAFA] font-[700] text-lg counter" data-target="350.00" data-prefix="RM " data-decimals="2">RM 0.00</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    .compare-card {
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
                    box-shadow 0.3s ease,
                    border-color 0.2s ease;
    }
    .compare-card:hover {
        transform: translateY(-4px);
        border-color: #333333;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.05),
                    0 20px 40px -10px rgba(0,0,0,0.4);
    }
    .compare-card-featured:hover {
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.05),
                    0 0 0 1px rgba(37,99,235,0.3),
                    0 20px 40px -10px rgba(0,0,0,0.5);
    }
</style>

<script is:inline>
    // Counter animation
    (function() {
        function animateCounter(el) {
            var target = parseFloat(el.dataset.target);
            var prefix = el.dataset.prefix || '';
            var decimals = parseInt(el.dataset.decimals || '0');
            var duration = 1200;
            var start = performance.now();

            function update(now) {
                var elapsed = now - start;
                var progress = Math.min(elapsed / duration, 1);
                // ease out cubic
                var eased = 1 - Math.pow(1 - progress, 3);
                var value = target * eased;
                el.textContent = prefix + value.toFixed(decimals);
                if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
        }

        var counters = document.querySelectorAll('.counter');
        var observed = new Set();

        var io = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting && !observed.has(entry.target)) {
                    observed.add(entry.target);
                    animateCounter(entry.target);
                }
            });
        }, { threshold: 0.5 });

        counters.forEach(function(c) { io.observe(c); });
    })();
</script>
