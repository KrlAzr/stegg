---
// src/components/Pricing.astro
---

<section id="pricing" class="w-full py-24 md:py-32 bg-slate-50/50 border-t border-slate-200/50 scroll-mt-20">
    <div class="max-w-6xl mx-auto px-6">
        
        <div class="grid md:grid-cols-2 gap-16 lg:gap-24 items-center">
            
            <div>
                <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6 tracking-tight leading-[1.1]">
                    The Performance Package
                </h2>
                <p class="text-lg text-slate-500 mb-10 font-medium">
                    Stop burning budget. Start converting traffic.
                </p>
                
                <ul class="space-y-6">
                     <li class="flex items-center gap-4 text-slate-600 font-medium text-lg">
                        <div class="w-6 h-6 rounded-full bg-[#2563EB]/10 flex items-center justify-center shrink-0">
                            <i data-lucide="check" class="w-3.5 h-3.5 text-[#2563EB]"></i>
                        </div>
                        <span><strong class="text-slate-900">Sub-Second Load Speed</strong> (Instant)</span>
                    </li>
                     <li class="flex items-center gap-4 text-slate-600 font-medium text-lg">
                        <div class="w-6 h-6 rounded-full bg-[#2563EB]/10 flex items-center justify-center shrink-0">
                            <i data-lucide="check" class="w-3.5 h-3.5 text-[#2563EB]"></i>
                        </div>
                        <span><strong class="text-slate-900">Google SEO Ready</strong> (Easier to Rank)</span>
                    </li>
                     <li class="flex items-center gap-4 text-slate-600 font-medium text-lg">
                        <div class="w-6 h-6 rounded-full bg-[#2563EB]/10 flex items-center justify-center shrink-0">
                            <i data-lucide="check" class="w-3.5 h-3.5 text-[#2563EB]"></i>
                        </div>
                        <span><strong class="text-slate-900">Premium Hosting Setup</strong> (Included)</span>
                    </li>
                    <li class="border-t border-slate-200 my-6 w-3/4"></li>
                    <li class="flex items-center gap-4 text-slate-600 font-medium text-lg">
                        <div class="w-6 h-6 rounded-full bg-slate-200/50 flex items-center justify-center shrink-0">
                            <i data-lucide="check" class="w-3.5 h-3.5 text-slate-700"></i>
                        </div>
                        <span><strong class="text-slate-900">High-Converting</strong> Sales Layout</span>
                    </li>
                    <li class="flex items-center gap-4 text-slate-600 font-medium text-lg">
                        <div class="w-6 h-6 rounded-full bg-slate-200/50 flex items-center justify-center shrink-0">
                            <i data-lucide="check" class="w-3.5 h-3.5 text-slate-700"></i>
                        </div>
                        <span><strong class="text-slate-900">10 Free</strong> Local SEO Pages (pSEO)</span>
                    </li>
                    <li class="flex items-center gap-4 text-slate-600 font-medium text-lg">
                        <div class="w-6 h-6 rounded-full bg-slate-200/50 flex items-center justify-center shrink-0">
                            <i data-lucide="check" class="w-3.5 h-3.5 text-slate-700"></i>
                        </div>
                        <span><strong class="text-slate-900">2 Revision</strong> Rounds Included</span>
                    </li>
                </ul>
            </div>
            
            <div class="w-full bg-white rounded-[2rem] p-10 md:p-12 border border-slate-200 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)] relative hover:shadow-[0_25px_50px_-15px_rgba(0,0,0,0.08)] transition-all duration-300">
                
                <div class="flex flex-col items-center mb-8">
                    <span class="text-slate-500 font-bold tracking-widest uppercase text-xs mb-4">Starts From</span>
                    <div class="flex items-start gap-1 text-slate-900">
                        <span class="text-2xl font-semibold mt-1">RM</span>
                        <span class="text-6xl md:text-7xl font-bold tracking-tighter leading-none">2,499</span>
                    </div>
                    <p class="text-sm text-slate-500 mt-6 font-medium text-center">Custom scopes available based on your exact business needs.</p>
                </div>

                <a 
                    href="https://wa.me/60196700413?text=Hi%20Stegg,%20I%20want%20to%20inquire%20about%20the%20RM2499%20Custom%20Website%20package." 
                    onclick="fbq('track', 'Contact');"
                    class="w-full py-4 px-8 bg-slate-900 text-white font-semibold text-center rounded-full transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5 hover:bg-slate-800 tracking-tight text-lg flex items-center justify-center gap-2"
                >
                    Discuss Your Project
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>
            
        </div>
    </div>
</section>