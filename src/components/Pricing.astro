---
// src/components/Pricing.astro
import NoiseGradient from './NoiseGradient.astro';
---

<section id="pricing" class="reveal w-full py-[120px] border-t border-[#222222] scroll-mt-20" style="background: radial-gradient(ellipse 60% 80% at 100% 50%, rgba(37,99,235,0.08) 0%, transparent 60%), #0F1117;">
    <div class="max-w-[1100px] mx-auto px-6">

        <div class="grid md:grid-cols-2 gap-16 lg:gap-24 items-center">

            <div>
                <p class="font-mono text-[11px] tracking-[0.15em] text-[#444444] uppercase mb-4">Pricing</p>
                <h2 class="text-[clamp(32px,4vw,52px)] font-[800] text-[#FAFAFA] mb-5 tracking-tight leading-[1.05]">
                    The <span class="gradient-word">Performance</span> Package
                </h2>
                <p class="text-[17px] text-[#888888] mb-10 leading-[1.7]">
                    Stop burning budget. Start converting traffic.
                </p>

                <ul class="space-y-5">
                    <li class="flex items-center gap-4 text-[#888888] text-[17px]">
                        <div class="w-6 h-6 rounded-full bg-[#2563EB]/15 border border-[#2563EB]/25 flex items-center justify-center shrink-0">
                            <i data-lucide="check" class="w-3.5 h-3.5 text-[#2563EB]"></i>
                        </div>
                        <span><strong class="text-[#FAFAFA] font-semibold">Sub-Second Load Speed</strong> (Instant)</span>
                    </li>
                    <li class="flex items-center gap-4 text-[#888888] text-[17px]">
                        <div class="w-6 h-6 rounded-full bg-[#2563EB]/15 border border-[#2563EB]/25 flex items-center justify-center shrink-0">
                            <i data-lucide="check" class="w-3.5 h-3.5 text-[#2563EB]"></i>
                        </div>
                        <span><strong class="text-[#FAFAFA] font-semibold">Google SEO Ready</strong> (Easier to Rank)</span>
                    </li>
                    <li class="flex items-center gap-4 text-[#888888] text-[17px]">
                        <div class="w-6 h-6 rounded-full bg-[#2563EB]/15 border border-[#2563EB]/25 flex items-center justify-center shrink-0">
                            <i data-lucide="check" class="w-3.5 h-3.5 text-[#2563EB]"></i>
                        </div>
                        <span><strong class="text-[#FAFAFA] font-semibold">Premium Hosting Setup</strong> (Included)</span>
                    </li>
                    <li class="border-t border-[#222222] my-2 w-3/4"></li>
                    <li class="flex items-center gap-4 text-[#888888] text-[17px]">
                        <div class="w-6 h-6 rounded-full bg-[#1A1A1A] border border-[#2A2A2A] flex items-center justify-center shrink-0">
                            <i data-lucide="check" class="w-3.5 h-3.5 text-[#888888]"></i>
                        </div>
                        <span><strong class="text-[#FAFAFA] font-semibold">High-Converting</strong> Sales Layout</span>
                    </li>
                    <li class="flex items-center gap-4 text-[#888888] text-[17px]">
                        <div class="w-6 h-6 rounded-full bg-[#1A1A1A] border border-[#2A2A2A] flex items-center justify-center shrink-0">
                            <i data-lucide="check" class="w-3.5 h-3.5 text-[#888888]"></i>
                        </div>
                        <span><strong class="text-[#FAFAFA] font-semibold">10 Free</strong> Local SEO Pages (pSEO)</span>
                    </li>
                    <li class="flex items-center gap-4 text-[#888888] text-[17px]">
                        <div class="w-6 h-6 rounded-full bg-[#1A1A1A] border border-[#2A2A2A] flex items-center justify-center shrink-0">
                            <i data-lucide="check" class="w-3.5 h-3.5 text-[#888888]"></i>
                        </div>
                        <span><strong class="text-[#FAFAFA] font-semibold">2 Revision</strong> Rounds Included</span>
                    </li>
                </ul>
            </div>

            <div class="pricing-card w-full bg-[#111111] rounded-2xl p-10 md:p-12 border border-[#222222] relative overflow-hidden" style="box-shadow: 0 0 60px rgba(37,99,235,0.12), 0 0 0 1px rgba(37,99,235,0.13), inset 0 1px 0 rgba(255,255,255,0.04);">

                <!-- Noise gradient aurora -->
                <NoiseGradient
                    colors={["#2563EB", "#8B5CF6"]}
                    width="600px"
                    height="400px"
                    opacity={12}
                />

                <div class="absolute top-0 right-0 w-48 h-48 rounded-full pointer-events-none" style="background: rgba(37,99,235,0.06); filter: blur(60px); z-index: 1;"></div>

                <div class="relative z-10 flex flex-col items-start mb-10">
                    <span class="font-mono text-[11px] tracking-[0.15em] text-[#444444] uppercase mb-6">Starts From</span>
                    <div class="flex items-start gap-1 text-[#FAFAFA]">
                        <span class="text-2xl font-semibold mt-1 text-[#888888]">RM</span>
                        <span class="font-[800] tracking-tight leading-none" style="font-size: clamp(60px, 8vw, 80px);">2,499</span>
                    </div>
                    <p class="text-sm text-[#888888] mt-5 leading-[1.6]">Custom scopes available based on your exact business needs.</p>
                </div>

                <a
                    href="https://wa.me/60196700413?text=Hi%20Stegg,%20I%20want%20to%20inquire%20about%20the%20RM2499%20Custom%20Website%20package."
                    onclick="fbq('track', 'Contact');"
                    class="cta-btn relative z-10 w-full py-4 px-8 bg-[#2563EB] text-white font-semibold text-center rounded-xl shadow-[0_8px_25px_rgba(37,99,235,0.3)] tracking-tight text-base flex items-center justify-center gap-2"
                >
                    Discuss Your Project
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
            </div>

        </div>
    </div>
</section>

<style>
    .pricing-card {
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
                    border-color 0.2s ease,
                    box-shadow 0.3s ease;
    }
    .pricing-card:hover {
        transform: translateY(-4px);
        border-color: #333333;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.05),
                    0 0 0 1px rgba(37,99,235,0.15),
                    0 25px 50px -15px rgba(0,0,0,0.5);
    }

    .cta-btn {
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
                    box-shadow 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .cta-btn:hover  { transform: scale(1.02) translateY(-1px); box-shadow: 0 12px 30px rgba(37,99,235,0.45); }
    .cta-btn:active { transform: scale(0.97); transition-duration: 0.1s; }

    .gradient-word {
        background: linear-gradient(135deg, #60a5fa, #a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
</style>
