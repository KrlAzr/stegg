---
// src/components/Footer.astro
const year = new Date().getFullYear();
---
<footer class="bg-[#050505] py-16 border-t border-[#1A1A1A]">
    <div class="max-w-[1100px] mx-auto px-6">

        <div class="grid md:grid-cols-2 gap-10 items-center border-b border-[#1A1A1A] pb-12 mb-8">

            <div class="flex flex-col items-start">
                <a href="/" class="flex items-center mb-4 group">
                    <img
                        src="/logo.png"
                        alt="Stegg.dev Logo"
                        class="h-8 w-auto transition-opacity duration-300 group-hover:opacity-60"
                    />
                </a>
                <p class="text-[#888888] text-sm font-medium max-w-xs leading-[1.6]">
                    High-performance websites engineered for modern local businesses.
                </p>
            </div>

            <div class="flex flex-wrap justify-start md:justify-end gap-x-8 gap-y-3 text-sm font-semibold text-[#888888]">
                <a href="/#why-stegg" class="hover:text-[#FAFAFA] transition-colors duration-200">Why Stegg</a>
                <a href="/#pricing" class="hover:text-[#FAFAFA] transition-colors duration-200">Pricing</a>
                <a href="/#about" class="hover:text-[#FAFAFA] transition-colors duration-200">About Us</a>
            </div>

        </div>

        <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-medium text-[#444444]">
            <p>&copy; {year} Stegg Systems. All rights reserved. Located in Malaysia.</p>

            <div class="flex items-center gap-1">
                <span>Engineered for performance.</span>
                <i data-lucide="zap" class="w-3.5 h-3.5 text-[#2563EB]"></i>
            </div>
        </div>

    </div>
</footer>
