---
interface Props {
  colors: string[];
  width?: string;
  height?: string;
  opacity?: number;
  className?: string;
  style?: string;
}

const {
  colors,
  width = '100%',
  height = '100%',
  opacity = 15,
  className = '',
  style = '',
} = Astro.props;

const id = `noise-${Math.random().toString(36).slice(2, 9)}`;
---

<canvas
  id={id}
  class={`absolute top-0 left-0 pointer-events-none ${className}`}
  style={`width: ${width}; height: ${height}; z-index: 0; ${style}`}
></canvas>

<script is:inline define:vars={{ id, colors, opacity }}>
(function () {
  function hexToRgb(hex) {
    var h = hex.replace('#', '');
    return {
      r: parseInt(h.slice(0, 2), 16),
      g: parseInt(h.slice(2, 4), 16),
      b: parseInt(h.slice(4, 6), 16),
    };
  }

  function draw() {
    var canvas = document.getElementById(id);
    if (!canvas) return;

    var rect = canvas.getBoundingClientRect();
    var w = rect.width || canvas.offsetWidth || 600;
    var h = rect.height || canvas.offsetHeight || 400;

    canvas.width = Math.round(w);
    canvas.height = Math.round(h);

    var ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, w, h);

    // Draw radial gradient blobs for each color
    colors.forEach(function (hex, i) {
      var rgb = hexToRgb(hex);
      var cx = (w / colors.length) * (i + 0.5) + (Math.random() - 0.5) * w * 0.25;
      var cy = h * (0.2 + Math.random() * 0.6);
      var r = Math.max(w, h) * 0.75;

      var grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);
      grad.addColorStop(0, 'rgba(' + rgb.r + ',' + rgb.g + ',' + rgb.b + ',0.28)');
      grad.addColorStop(1, 'rgba(' + rgb.r + ',' + rgb.g + ',' + rgb.b + ',0)');

      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, w, h);
    });

    // Overlay procedural grain noise
    var imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
    var data = imageData.data;
    var noiseAmp = opacity * 2.55;

    for (var i = 0; i < data.length; i += 4) {
      var n = (Math.random() - 0.5) * noiseAmp;
      data[i]     = Math.max(0, Math.min(255, data[i]     + n));
      data[i + 1] = Math.max(0, Math.min(255, data[i + 1] + n));
      data[i + 2] = Math.max(0, Math.min(255, data[i + 2] + n));
    }
    ctx.putImageData(imageData, 0, 0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', draw);
  } else {
    requestAnimationFrame(draw);
  }
})();
</script>
