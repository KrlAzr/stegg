---
// src/components/Navbar.astro
---

<header class="fixed w-full top-0 z-50 border-b border-slate-200/60 bg-white/70 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex justify-between items-center h-20">
      
      <a href="/" class="flex items-center group">
        <img 
            src="/logo.png" 
            alt="Stegg.dev Logo" 
            class="h-8 md:h-9 w-auto transition-all duration-300 group-hover:opacity-80" 
        />
      </a>

      <nav class="hidden md:flex items-center gap-8 h-full">
        <a href="/#why-stegg" class="text-sm font-medium text-slate-500 hover:text-[#2563EB] transition-colors">Why Stegg</a>
        <a href="/#pricing" class="text-sm font-medium text-slate-500 hover:text-[#2563EB] transition-colors">Pricing</a>
        <a href="/#about" class="text-sm font-medium text-slate-500 hover:text-[#2563EB] transition-colors">About</a>
      </nav>

      <div class="hidden md:flex items-center gap-4">
        <a href="https://wa.me/60196700413?text=Hi%20Stegg,%20I'm%20interested%20in%20your%20services." 
           class="px-6 py-2.5 bg-slate-900 text-white text-sm font-semibold rounded-full hover:bg-slate-800 transition-all shadow-sm hover:shadow-md">
          Let's Talk
        </a>
      </div>

      <button id="menu-btn" class="md:hidden p-2 text-slate-500 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors focus:outline-none">
        <i data-lucide="menu" class="w-6 h-6"></i>
      </button>

    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white absolute w-full left-0 shadow-2xl">
    <div class="flex flex-col p-4 space-y-1">
      <a href="/#why-stegg" class="text-slate-600 hover:text-[#2563EB] font-medium py-3 px-4 hover:bg-slate-50 rounded-xl transition-colors">Why Stegg</a>
      <a href="/#pricing" class="text-slate-600 hover:text-[#2563EB] font-medium py-3 px-4 hover:bg-slate-50 rounded-xl transition-colors">Pricing</a>
      <a href="/#about" class="text-slate-600 hover:text-[#2563EB] font-medium py-3 px-4 hover:bg-slate-50 rounded-xl transition-colors">About</a>
      
      <div class="pt-4 mt-2 border-t border-slate-100">
          <a href="https://wa.me/60196700413?text=Hi%20Stegg,%20I'm%20interested%20in%20your%20services." class="block w-full text-center px-6 py-3 bg-slate-900 text-white font-semibold rounded-xl shadow-sm hover:bg-slate-800 transition-colors">
            Let's Talk
          </a>
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
    
    // Close menu when clicking links
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>