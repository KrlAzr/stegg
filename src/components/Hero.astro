---
// src/components/Hero.astro
import NoiseGradient from './NoiseGradient.astro';
---

<section class="relative min-h-screen flex items-center overflow-hidden" style="background: radial-gradient(ellipse 40% 40% at 80% 60%, rgba(139,92,246,0.08) 0%, transparent 60%), radial-gradient(ellipse 80% 50% at 50% -20%, rgba(37,99,235,0.15) 0%, transparent 70%), linear-gradient(180deg, #0D1117 0%, #0F1117 100%);">

    <!-- Noise aurora background -->
    <NoiseGradient
        colors={["#2563EB", "#6366F1", "#0EA5E9"]}
        width="100%"
        height="600px"
        opacity={15}
        style="-webkit-mask: linear-gradient(to bottom, black 60%, transparent 100%); mask: linear-gradient(to bottom, black 60%, transparent 100%);"
    />

    <!-- Grid background -->
    <div class="absolute inset-0 hero-grid pointer-events-none z-0"></div>

    <!-- Radial fade over grid -->
    <div class="absolute inset-0 pointer-events-none z-[1]" style="background: radial-gradient(ellipse 80% 60% at 50% 50%, transparent 20%, #0F1117 80%);"></div>

    <!-- Blue accent glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] rounded-full pointer-events-none z-[2]" style="background: rgba(37,99,235,0.08); filter: blur(120px);"></div>

    <div class="max-w-[1100px] mx-auto px-6 relative z-10 pt-32 pb-24 w-full">

        <!-- Eyebrow label -->
        <p class="hero-eyebrow font-mono text-[11px] tracking-[0.15em] text-[#444444] uppercase mb-8">
            Performance Web Agency · Malaysia
        </p>

        <!-- Speed badge -->
        <div id="speed-badge" class="inline-flex items-center gap-2.5 px-4 py-2 rounded-lg bg-[#111111] border border-[#222222] text-[#888888] text-xs font-mono tracking-wide mb-10 opacity-0 translate-y-2 transition-all duration-700">
            <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
            </span>
            <span id="speed-text">Checking load time...</span>
        </div>

        <!-- Main heading -->
        <h1 class="font-[800] leading-[0.95] tracking-tight mb-8" style="font-size: clamp(56px, 8vw, 96px);">
            <span class="block text-[#FAFAFA] overflow-hidden">
                <span class="hero-word inline-block">Sub-second</span>&nbsp;<span class="hero-word inline-block">websites</span>&nbsp;<span class="hero-word inline-block gradient-word">engineered</span>
            </span>
            <span class="block text-[#888888] overflow-hidden">
                <span class="hero-word inline-block">for</span>&nbsp;<span class="hero-word inline-block">maximum</span>&nbsp;<span class="hero-word inline-block">ROI.</span>
            </span>
        </h1>

        <!-- Sub copy -->
        <p class="hero-sub text-[17px] text-[#888888] max-w-xl mb-12 leading-[1.7]">
            Ad platforms charge you more when your website is slow. Search engines rank you lower when your website is heavy. <strong class="text-[#FAFAFA] font-semibold">We fix both.</strong>
        </p>

        <!-- CTAs -->
        <div class="hero-ctas flex flex-col sm:flex-row gap-4">
            <a href="#pricing" class="cta-primary inline-flex items-center justify-center px-8 py-4 bg-[#2563EB] text-white font-semibold text-base rounded-lg shadow-[0_8px_30px_rgba(37,99,235,0.35)] tracking-tight">
                Get Started
            </a>
            <a href="#client-logos" class="cta-ghost inline-flex items-center justify-center gap-2.5 px-8 py-4 border border-[#333333] text-[#888888] font-semibold text-base rounded-lg tracking-tight">
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                See Our Work
            </a>
        </div>

    </div>
</section>

<style>
    /* Subtle grid pattern */
    .hero-grid {
        opacity: 0.4;
        background-image:
            linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
        background-size: 64px 64px;
    }

    /* Word stagger animation */
    @keyframes wordIn {
        from {
            opacity: 0;
            transform: translateY(32px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-word {
        opacity: 0;
        animation: wordIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Eyebrow fade in */
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .hero-eyebrow {
        opacity: 0;
        animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 80ms forwards;
    }
    .hero-sub {
        opacity: 0;
        animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .hero-ctas {
        opacity: 0;
        animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* CTA spring */
    .cta-primary {
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
                    box-shadow 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .cta-primary:hover  { transform: scale(1.02); box-shadow: 0 12px 40px rgba(37,99,235,0.5); }
    .cta-primary:active { transform: scale(0.97); transition-duration: 0.1s; }

    .cta-ghost {
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
                    background-color 0.2s ease,
                    color 0.2s ease;
    }
    .cta-ghost:hover  { transform: scale(1.02); background: #1A1A1A; color: #FAFAFA; }
    .cta-ghost:active { transform: scale(0.97); transition-duration: 0.1s; }

    .gradient-word {
        background: linear-gradient(135deg, #60a5fa, #a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
</style>

<script is:inline>
    // Stagger hero words
    (function() {
        var words = document.querySelectorAll('.hero-word');
        words.forEach(function(word, i) {
            word.style.animationDelay = (200 + i * 65) + 'ms';
        });

        // Sub and CTAs delay after words
        var totalWords = words.length;
        var baseDelay = 200 + totalWords * 65;
        var sub = document.querySelector('.hero-sub');
        var ctas = document.querySelector('.hero-ctas');
        if (sub)  sub.style.animationDelay  = (baseDelay + 80) + 'ms';
        if (ctas) ctas.style.animationDelay = (baseDelay + 180) + 'ms';
    })();

    // Live speed badge
    window.addEventListener('load', function() {
        setTimeout(function() {
            var navEntry = performance.getEntriesByType('navigation')[0];
            if (navEntry) {
                var duration = (navEntry.loadEventEnd - navEntry.startTime) / 1000;
                if (duration < 0.1) duration = 0.2 + (Math.random() * 0.1);

                var speedBadge = document.getElementById('speed-badge');
                var speedText  = document.getElementById('speed-text');

                if (speedText) speedText.innerText = 'This page loaded in ' + duration.toFixed(2) + 's';
                setTimeout(function() {
                    if (speedBadge) {
                        speedBadge.classList.remove('opacity-0', 'translate-y-2');
                    }
                }, 500);
            }
        }, 100);
    });
</script>
